{
  "name": "kbcut",
  "version": "1.0.4",
  "description": "Windows 口播视频 AI 剪辑工具（口播智剪）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/",
    "check": "npm run typecheck && npm test && npm run build",
    "dist:publish": "electron-builder --publish always"
  },
  "keywords": [
    "electron",
    "video",
    "asr",
    "llm",
    "windows",
    "kbcut",
    "口播"
  ],
  "author": "CGLY",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@huggingface/transformers": "^4.2.0",
    "antd": "^6.5.0",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-common": "^1.24.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cglyvip/kbcut.git"
  },
  "private": true,
  "bugs": {
    "url": "https://github.com/cglyvip/kbcut/issues"
  },
  "homepage": "https://github.com/cglyvip/kbcut#readme",
